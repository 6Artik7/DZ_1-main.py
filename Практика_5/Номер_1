TAX_RATE = 0.13

annual_income = float(input("Введите годовой доход: "))

tax_amount = annual_income * TAX_RATE
income_after_tax = annual_income - tax_amount

print(f"Общая сумма дохода: {annual_income:,.2f} руб.")
print(f"Сумма рассчитанного налога: {tax_amount:,.2f} руб.")
print(f"Сумма «на руки» после вычета налога: {income_after_tax:,.2f} руб.")
