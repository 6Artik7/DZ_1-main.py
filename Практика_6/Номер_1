t = float(input("Введите температуру:"))
p = int(input("Введите давление:"))
hr = int(input("Введите пульс в минуту:"))

if (t < 35 or t > 38
or p < 105 or p > 140
or hr < 55 or hr > 110):
    print("Требуется врач")
elif (35 <= t < 36 or 37 < t <= 38) or (105 <= p < 110 or 130 < p <= 140) or (55 <= hr < 60 or 100 < hr <= 110):
    print("Лёгкое недомогание")
else:
    print("Нормальное состояние")
